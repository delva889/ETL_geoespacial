POSTGIS_1_DEF caudales_saih   postgis_type                 postgis_geometry   postgis_mode                 ""   postgis_sql_key_columns      ""   postgis_drop_table           ""   postgis_truncate_table       ""   fme_feature_operation        INSERT   fme_table_handling           DROP_CREATE   postgis_create_with_oids     NO   postgis_create_spatial_index GiST   postgis_spatial_column_type  ""   postgis_spatial_column       ""   postgis_srid                 ""   postgis_vacuum_analyze       NO   postgis_allow_serial_writing NO   postgis_clustering           NO   fme_constant_feature_type    YES   fme_geometry_name:geom       spatial_type,from_first_feature   id                           varchar   nombre                       varchar   caudal_m3_por_s              numeric(10,2)   cuenca                       varchar   fecha                        varchar   direccion_google             varchar   _latitude                    varchar   _longitude                   varchar


