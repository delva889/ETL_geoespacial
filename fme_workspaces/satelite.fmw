# -------------------------------------------------------------------------

MACRO FME_VIEWER_APP fmedatainspector
# -------------------------------------------------------------------------

FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   MULTI_READER_KEYWORD $(DATASET_KEYWORD_POSTGIS_1)   INPUT FEATURE_TYPE *    ROUTE POSTGIS POSTGIS_1::public.embalses_geom multi_reader_keyword,$(DATASET_KEYWORD_POSTGIS_1) TO FME_GENERIC ::public.embalses_geom ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
POSTGIS_1_MERGE_DEF POSTGIS_1::public.embalses_geom EXACT public.embalses_geom DEFLINE postgis_sql_where_clause,,postgis_sql_statement,,fid,serial<comma>PrimaryKey,timestamp,timestamptz,cuenca,varchar,cuenca_norm,varchar,pantano,varchar,capacidad,int8,embalsada,varchar,variacion,varchar
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "public.embalses_geom_POSTGIS_1 Splitter"    INPUT FEATURE_TYPE public.embalses_geom    OUTPUT FEATURE_TYPE public.embalses_geom_POSTGIS_1
DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
FACTORY_DEF {*} ReprojectFactory    FACTORY_NAME { Reprojector }    INPUT  FEATURE_TYPE public.embalses_geom_POSTGIS_1    ENGINE { SOURCE "EPSG:25830" DESTINATION "EPSG:4326" }    INTERPOLATION_TYPE { NearestNeighbor }    RASTER_CELL_SIZE { PreserveCells }    RASTER_TOLERANCE { "0.0" }    OUTPUT { REPROJECTED FEATURE_TYPE Reprojector_REPROJECTED          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { BoundsExtractor }    INPUT  FEATURE_TYPE Reprojector_REPROJECTED    OUTPUT { FEATURE_TYPE BoundsExtractor_OUTPUT         @Bounds(fme_encoded,_xmin,_xmax,_ymin,_ymax,_zmin,_zmax,GEOMETRIC)          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} GeometryExtractorFactory    FACTORY_NAME { GeometryExtractor }    INPUT  FEATURE_TYPE BoundsExtractor_OUTPUT    GEOMETRY_ENCODING { GEOJSON }    DEST_ATTR_NAME { "aoi_geojson" }    REMOVE_GEOMETRY { No }    LEVELS_ATTR { <Unused> }    OGCVERSION { <Unused> }    OGC_WKT_PRECISION { <Unused> }    JSON_MAX_DIGITS { 7 }    OMIT_NAMESPACES { <Unused> }    PREFER_POLYGON_OVER_SURFACE { <Unused> }    SRS_NAME { <Unused> }    SRS_AXIS_ORDER { <Unused> }    GENERATE_GEOMETRY_IDS { <Unused> }    GEOHASH_PRECISION { <Unused> }    OGEOSMS_URL_PREFIX { <Unused> }    ELLIPSOID_NAME { <Unused> }    LETTERING_TYPE { <Unused> }    PRECISION { "<Unused>" }    MSSQL_FORMAT { "<Unused>" }    ISO6709_FORMAT { "<Unused>" }    ISO6709_MAX_DECIMAL_PLACES { "<Unused>" }    OUTPUT { OUTPUT FEATURE_TYPE GeometryExtractor_OUTPUT        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} XMLTemplaterFactory FACTORY_NAME { JSONTemplater } INPUT CONTROL_FEATURE FEATURE_TYPE GeometryExtractor_OUTPUT INPUT DATA_FEATURE FEATURE_TYPE JSONTemplater_DataFeatures RESULT_ATTR { "_result" } OUTPUT_XML_HEADER NO BUCKET_ATTR_NAME __xml_templater_bucket__ CONTROL_TEMPLATE_EXPR { <opencurly><lf><space><space><quote>collections<quote>:<space><openbracket><quote>sentinel-2-l2a<quote><closebracket><comma><lf><space><space><quote>datetime<quote>:<space><quote>2024-12-01T00:00:00Z<solidus>2026-12-30T23:59:59Z<quote><comma><lf><space><space><quote>intersects<quote>:<space>fme:get-json-attribute<openparen><quote>aoi_geojson<quote><closeparen><comma><lf><space><space><quote>limit<quote>:<space>5<comma><lf><space><space><quote>query<quote>:<space><opencurly><lf><space><space><space><space><quote>eo:cloud_cover<quote>:<space><opencurly><lf><space><space><space><space><space><space><quote>lt<quote>:<space>10<lf><space><space><space><space><closecurly><lf><space><space><closecurly><lf><closecurly> } OUTPUT XML_DOCUMENT FEATURE_TYPE JSONTemplater_OUTPUT
# -------------------------------------------------------------------------
# Combine the two "file path attribute" parameters into one value.
DEFAULT_MACRO HTTPCaller_FILE_PATH_ATTR
INCLUDE [ 	if { {<Unused>} == {<Unused>} } { 		puts {MACRO HTTPCaller_FILE_PATH_ATTR "<Unused>"}; 	} else { 		puts {MACRO HTTPCaller_FILE_PATH_ATTR "<Unused>"}; 	} ]
FACTORY_DEF {CONNECTED} CreationFactory    FACTORY_NAME { HTTPCaller_Creator }    OUTPUT { FEATURE_TYPE HTTPCaller_____CREATED______ }
